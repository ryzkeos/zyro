# ─────────────────────────────────────────────────────────────────────────────
# Zyro AI Backend Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Development (default): SQLite - no configuration needed
# Production: PostgreSQL - set DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/zyro

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED for production! Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# DO NOT use placeholder values like "secret" or "changeme"
SECRET_KEY=

# ── AI API Keys ─────────────────────────────────────────────────────────────
# Yuruzu (Google Gemini) API keys - comma-separated for rotation
YURUZU_API_KEY=your-gemini-api-key-here

# Xenon (Groq) API keys - comma-separated for rotation
XENON_API_KEY=your-groq-api-key-here

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:7004

# ── Environment ─────────────────────────────────────────────────────────────
FLASK_ENV=development
COOKIE_SECURE=false

# ── Security Headers ────────────────────────────────────────────────────────
# Customize CSP if needed (optional)
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=Zyro AI <noreply@your-domain.com>

# ── Redis Cache (Upstash) ────────────────────────────────────────────────────
# Optional - if not set, caching is disabled
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here
REDIS_CACHE_TTL=3600

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: python generate_vapid.py
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_CLAIMS_EMAIL=admin@your-domain.com

# ── Gunicorn Server ──────────────────────────────────────────────────────────
PORT=5004
WORKERS=4                    # (2 * CPU cores) + 1 recommended
WORKER_CLASS=sync            # sync, gevent, eventlet
THREADS=1
LOG_LEVEL=info               # debug, info, warning, error
ACCESS_LOG=-                 # '-' for stdout, or file path
ERROR_LOG=-                  # '-' for stdout, or file path
DAEMON=false                 # true for background mode
PID_FILE=/tmp/zyro.pid       # Optional PID file path